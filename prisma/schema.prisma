generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// System users (login accounts)
model User {
  id               String    @id @default(cuid())
  username         String    @unique
  passwordHash     String    @map("password_hash")
  role             UserRole
  employeeId       String?   @unique @map("employee_id")
  status           String    @default("active") // active | inactive | locked
  lastLogin        DateTime? @map("last_login")
  loginAttempts    Int       @default(0) @map("login_attempts")
  lockedUntil      DateTime? @map("locked_until")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt        DateTime  @default(now()) @map("created_at")

  employee   Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  shiftAssignmentsGiven ShiftAssignment[] @relation("AssignedBy")
  passwordResetRequests PasswordResetRequest[]
  passwordResetApprovals PasswordResetRequest[] @relation("PasswordResetApprovals")
  leaveApprovals LeaveRequest[] @relation("LeaveApprovals")
  overtimeApprovals OvertimeRequest[] @relation("OvertimeApprovals")
  attendanceCorrectionApprovals AttendanceCorrectionRequest[] @relation("AttendanceCorrectionApprovals")

  @@map("users")
}

model PasswordResetRequest {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  requestReason      String?   @map("request_reason")
  requestTime        DateTime  @default(now()) @map("request_time")
  approvedById       String?   @map("approved_by")
  approvedTime       DateTime? @map("approved_time")
  status             String    @default("pending") // pending | approved | rejected
  generatedPassword  String?   @map("generated_password")
  tempPasswordExpiry DateTime? @map("temp_password_expiry")

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("PasswordResetApprovals", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("password_reset_requests")
}

enum UserRole {
  admin
  manager
  staff
}

// Employee records (never deleted - use status = inactive)
model Employee {
  id            String    @id @default(cuid())
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  email         String    @unique
  phone         String?
  address       String?
  dateOfBirth   DateTime? @map("date_of_birth")
  hireDate      DateTime  @map("hire_date")
  contractEndDate DateTime? @map("contract_end_date")
  departmentId  String?   @map("department_id")
  positionId    String?   @map("position_id")
  status        EmployeeStatus @default(active)
  baseSalary    Int?      @map("base_salary") // monthly salary in VND
  annualLeaveBalance Int  @default(12) @map("annual_leave_balance")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position   Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  user       User?
  shiftAssignments ShiftAssignment[]
  attendance  Attendance[]
  attendanceEdits  AttendanceEdit[] @relation("EditedBy")
  employeeTrainings EmployeeTraining[]
  leaveRequests LeaveRequest[]
  overtimeRequests OvertimeRequest[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]

  @@map("employees")
}

model LeaveRequest {
  id          String   @id @default(cuid())
  employeeId  String   @map("employee_id")
  leaveType   String   @map("leave_type") // annual | sick | unpaid | emergency
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  reason      String?
  status      String   @default("pending") // pending | approved | rejected
  approvedById String? @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy  User?    @relation("LeaveApprovals", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("leave_requests")
}

model OvertimeRequest {
  id          String   @id @default(cuid())
  employeeId  String   @map("employee_id")
  workDate    DateTime @map("work_date") @db.Date
  hours       Float    @map("hours")
  reason      String?
  status      String   @default("pending") // pending | approved | rejected
  approvedById String? @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy  User?    @relation("OvertimeApprovals", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("overtime_requests")
}

model AttendanceCorrectionRequest {
  id            String   @id @default(cuid())
  employeeId    String   @map("employee_id")
  attendanceId  String   @map("attendance_id")
  requestedCheckIn  DateTime? @map("requested_check_in")
  requestedCheckOut DateTime? @map("requested_check_out")
  reason        String?
  status        String   @default("pending") // pending | approved | rejected
  approvedById  String?  @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime @default(now()) @map("created_at")

  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance  Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  approvedBy  User?      @relation("AttendanceCorrectionApprovals", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("attendance_correction_requests")
}

enum EmployeeStatus {
  active
  inactive
  contract_ending_soon
  left
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique @map("department_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  employees Employee[]

  @@map("departments")
}

model Position {
  id          String  @id @default(cuid())
  name        String  @unique @map("position_name")
  description String?

  employees Employee[]

  @@map("positions")
}

model Shift {
  id            String   @id @default(cuid())
  name          String   @unique @map("shift_name")
  startTime     String   @map("start_time")  // e.g. "09:00"
  endTime       String   @map("end_time")    // e.g. "17:00"
  requiredStaff Int      @default(1) @map("required_staff")
  createdAt     DateTime @default(now()) @map("created_at")

  assignments ShiftAssignment[]

  @@map("shifts")
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  shiftId    String   @map("shift_id")
  workDate   DateTime @map("work_date") @db.Date
  assignedById String? @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, shiftId, workDate])
  @@map("shift_assignments")
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  workDate   DateTime @map("work_date") @db.Date
  checkIn    DateTime? @map("check_in")
  checkOut   DateTime? @map("check_out")
  status     String   @default("pending") // pending | present | absent | late
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  edits    AttendanceEdit[]
  correctionRequests AttendanceCorrectionRequest[]

  @@unique([employeeId, workDate])
  @@map("attendance")
}

model AttendanceEdit {
  id           String   @id @default(cuid())
  attendanceId String   @map("attendance_id")
  editedById   String   @map("edited_by")
  oldCheckIn   DateTime? @map("old_check_in")
  oldCheckOut  DateTime? @map("old_check_out")
  newCheckIn   DateTime? @map("new_check_in")
  newCheckOut  DateTime? @map("new_check_out")
  editReason   String?  @map("edit_reason")
  editedAt     DateTime @default(now()) @map("edited_at")

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  editedBy   Employee   @relation("EditedBy", fields: [editedById], references: [id], onDelete: Cascade)

  @@map("attendance_edits")
}

model Training {
  id          String    @id @default(cuid())
  title       String    @map("training_title")
  description String?
  deadline    DateTime?
  createdAt   DateTime  @default(now()) @map("created_at")

  employeeTrainings EmployeeTraining[]

  @@map("trainings")
}

model EmployeeTraining {
  id             String   @id @default(cuid())
  employeeId     String   @map("employee_id")
  trainingId     String   @map("training_id")
  status         TrainingStatus @default(pending)
  completionDate DateTime? @map("completion_date")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([employeeId, trainingId])
  @@map("employee_training")
}

enum TrainingStatus {
  pending
  completed
}

model HrDocument {
  id         String   @id @default(cuid())
  title      String
  content    String?  @db.Text
  category   String?  // e.g. "HR Policies", "Workplace Rules", "Compensation"
  fileUrl    String   @map("file_url")
  approvedBy String?  @map("approved_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("hr_documents")
}
